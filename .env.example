# 로컬 개발용 설정 예시. 실제 값은 .env.local 에 넣습니다(.env.local 은 저장소에 올라가지 않습니다).
# 카카오 JavaScript 키: 등록한 도메인에서만 작동합니다(localhost:8080, github.io 주소).
VITE_KAKAO_JS_KEY=
# 지도 모드: kakao(실제 지도) | fake(테스트용 가짜 지도)
VITE_MAP_MODE=kakao
# 화면 테스트 서버 포트(선택). 같은 컴퓨터에서 다른 폴더(Codex 등)와 동시에 테스트할 때만 바꿉니다. 예: Claude Code 폴더는 4174
# E2E_PORT=4174
# 카카오 REST 키는 여기 적지 않습니다. 좌표 찾기 스크립트를 돌릴 때만 환경 변수 KAKAO_REST_KEY 로 넘깁니다.
